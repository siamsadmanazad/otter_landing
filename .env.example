# TripOtter landing — environment (copy to .env.local; .env.local is gitignored).

# Supabase — the DEDICATED MARKETING project (separate from the main app, so this
# service_role key can never touch real users). Marketing data lives in the `growth` schema.
NEXT_PUBLIC_SUPABASE_URL="https://<marketing-project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server only — never expose to the browser

# Public site origin — used to build verify + referral links in emails (no trailing slash).
NEXT_PUBLIC_SITE_URL="https://tripotter.com"

# Secret to download the leads CSV at /api/admin/leads?key=...  (generate: openssl rand -hex 24)
ADMIN_EXPORT_SECRET="<random-secret>"

# Email (Brevo, 300/day free) — welcome + double-opt-in verify mail. Unset = email cleanly
# no-ops (still logged to email_logs). Sender email/domain must be verified in Brevo.
# BREVO_API_KEY="xkeysib-..."
# MAIL_FROM="otti@tripotter.com"
# MAIL_FROM_NAME="TripOtter"

# Optional social-proof floor added to the real joined count (0 = off, fully honest).
# FOUNDERS_BASELINE="0"

# Analytics / ad-conversion tracking — unset = nothing loads (no third-party requests).
# NEXT_PUBLIC_FB_PIXEL_ID="..."     # Meta Pixel (measure/optimize paid social ads)
# NEXT_PUBLIC_GA_ID="G-..."         # Google Analytics 4

# Anti-bot (Cloudflare Turnstile) — unset = widget hidden + server check skipped.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
# TURNSTILE_SECRET_KEY="0x..."                    # server only

# Optional — launch-day override ("true" forces Download-Now CTAs; otherwise date-driven 08.05.2026)
# NEXT_PUBLIC_LAUNCH_MODE="false"
